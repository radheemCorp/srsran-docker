# Variable=Value, Explanation
# ${OPEN5GS_IP}=172.16.1.2, The UPF binds to its own interface inside the Docker bridge.
# ${UPF_ADVERTISE_IP}=172.16.1.2, Tells the gNB to send user data to the bridge IP.
# ${UE_IP_RANGE}=10.45.0.0/16, Standard default for Open5GS UEs (tun0).
# ${UE_GATEWAY_IP}=10.45.0.1, The internal gateway for the UE traffic.

MONGODB_IP=0.0.0.0
OPEN5GS_IP=172.16.1.2
UE_IP_BASE=10.46.0
UE_IP_RANGE=10.46.0.0/24
UE_GATEWAY_IP=10.46.0.1
UPF_ADVERTISE_IP=172.16.1.2
DEBUG=false
SUBSCRIBER_DB=subscriber_db.csv
NETWORK_NAME_FULL=rptestbed_msi
NETWORK_NAME_SHORT=rptestmsi

# Timezone - this setting will also be conveyed by Open5GS towards UE via "configuration update command"; comment for UTC
TZ=Europe/Madrid
SST_VALUE=1
SD_VALUE=0x111111