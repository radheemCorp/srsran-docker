# multi_ue: one container hosting N srsUEs, all sharing UE_HOST_IP and
# multiplexed by ZMQ port. Max NUM_UES is bounded by the open5gs subscriber_db
# (currently 4 IMSIs: 001010000000001..004).
NUM_UES=2

# Networking. The gNB's ZMQ rx_port already points at 10.10.4.237:2001, so keep
# UE_HOST_IP here unless you also change the gNB device_args.
GNB_IP=10.10.3.231
UE_HOST_IP=10.10.4.237
UE_BIND_IP=10.10.4.237
ZMQ_BRIDGE_IP=10.10.4.237
UE_ZMQ_MODE=bridge

# SINGLE-CELL mode: CELL2_UES empty -> start_all.sh runs only the cell-1 bridge
# and all NUM_UES UEs attach to the single gNB (slice sst=1). The GNB2_* knobs
# are unused here (kept commented for reference).
CELL2_UES=
# GNB2_IP=10.10.3.232
# GNB2_TX_PORT=2010
# GNB2_RX_PORT=2011

# Per-UE netns DNS.
UE_DNS1=1.1.1.1
UE_DNS2=8.8.8.8

# Set to true to keep the container idle (run start_all.sh manually).
DEBUG_MODE=true
